digraph "OpCondition"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="OpCondition",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Represents a composite condition formed by combining two conditions with an operator."];
  Node2 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="Condition",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCondition.html",tooltip="Represents a condition that can be toggled and emits signals based on its state."];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" cond1\ncond2" ,fontname="Helvetica"];
}
